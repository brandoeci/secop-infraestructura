/// Tabla puente del RLS: correo del supervisor -> departamento que puede ver. Las filas son de EJEMPLO; en produccion vendrian de un origen real.
table mapa_usuarios
	isHidden
	lineageTag: 8b1d4e22-5f03-47a9-9c16-2e7a0d5b3f44

	column correo
		dataType: string
		lineageTag: 1c9f7a30-62b4-4d58-8e71-05a3c6d2b907
		summarizeBy: none
		sourceColumn: correo

		annotation SummarizationSetBy = Automatic

	column departamento
		dataType: string
		lineageTag: 4a2e8b16-9d70-41c3-b5f8-7e60d1a9c238
		summarizeBy: none
		sourceColumn: departamento

		annotation SummarizationSetBy = Automatic

	partition mapa_usuarios = m
		mode: import
		source =
				let
				    Origen = #table(
				        type table [correo = text, departamento = text],
				        {
				            {"supervisor.antioquia@ejemplo.gov.co", "Antioquia"},
				            {"supervisor.magdalena@ejemplo.gov.co", "Magdalena"},
				            {"supervisor.bogota@ejemplo.gov.co", "Distrito Capital de Bogotá"}
				        }
				    )
				in
				    Origen

	annotation PBI_ResultType = Table
