table hecho_contratos
	lineageTag: edc0068e-577f-4118-92df-b47849d5f6b5

	/// Numero de contratos en el contexto actual.
	measure 'Contratos' =
			COUNTROWS ( hecho_contratos )
		formatString: #,0
		lineageTag: ee6382a2-3aec-40df-9ce0-fde37ea6bbfb

	/// Excluye el registro con valor no confiable. Ver docs/calidad-datos.md.
	measure 'Valor contratado' =
			CALCULATE (
			    SUM ( hecho_contratos[valor_contratado] ),
			    hecho_contratos[valor_confiable] = TRUE ()
			)
		formatString: #,0
		lineageTag: eae1f909-9985-4796-bc92-426fbbea9268

	/// Excluye el registro con valor no confiable.
	measure 'Valor pagado' =
			CALCULATE (
			    SUM ( hecho_contratos[valor_pagado] ),
			    hecho_contratos[valor_confiable] = TRUE ()
			)
		formatString: #,0
		lineageTag: 00f75c98-30ec-4175-b621-f467cb693830

	/// Acotada a contratos ya terminados (pago_exigible). Sobre todo el universo daria 13,4 %, que no describe la realidad porque mezcla contratos que todavia no tenian por que haber pagado nada. Decision D4.
	measure '% ejecutado' =
			VAR Contratado =
			    CALCULATE (
			        SUM ( hecho_contratos[valor_contratado] ),
			        hecho_contratos[valor_confiable] = TRUE (),
			        hecho_contratos[pago_exigible] = TRUE ()
			    )
			VAR Pagado =
			    CALCULATE (
			        SUM ( hecho_contratos[valor_pagado] ),
			        hecho_contratos[valor_confiable] = TRUE (),
			        hecho_contratos[pago_exigible] = TRUE ()
			    )
			RETURN
			    DIVIDE ( Pagado, Contratado )
		formatString: 0.0%
		lineageTag: afec5df7-5d6c-40f2-80bb-01b80642ae24

	/// Que porcentaje de los contratos ya terminados reporta cero pagado. Es un hallazgo del informe, no un defecto que haya que esconder.
	measure '% sin ejecucion reportada' =
			VAR Terminados =
			    CALCULATE (
			        COUNTROWS ( hecho_contratos ),
			        hecho_contratos[pago_exigible] = TRUE ()
			    )
			VAR SinReporte =
			    CALCULATE (
			        COUNTROWS ( hecho_contratos ),
			        hecho_contratos[pago_exigible] = TRUE (),
			        hecho_contratos[valor_pagado] = 0
			    )
			RETURN
			    DIVIDE ( SinReporte, Terminados )
		formatString: 0.0%
		lineageTag: e8755dde-84d5-41d3-b1f1-b8026ec13352

	/// El universo arranca el 2023-10-05, asi que 2023 es un anio parcial y su comparacion contra 2022 no existe.
	measure 'Valor contratado anio anterior' =
			CALCULATE ( [Valor contratado], SAMEPERIODLASTYEAR ( dim_fecha[fecha] ) )
		formatString: #,0
		lineageTag: c26b9349-4c5e-4dcb-8234-e5aa43fa8683

	/// Variacion del valor contratado frente al mismo periodo del anio anterior.
	measure 'Variacion anual %' =
			DIVIDE (
			    [Valor contratado] - [Valor contratado anio anterior],
			    [Valor contratado anio anterior]
			)
		formatString: 0.0%
		lineageTag: 40235707-65b8-4aca-8e0e-802bd5ba6a40

	/// Posicion de la entidad por valor contratado.
	measure 'Ranking entidad' =
			IF (
			    ISINSCOPE ( dim_entidad[nombre_entidad] ),
			    RANKX (
			        ALLSELECTED ( dim_entidad[nombre_entidad] ),
			        [Valor contratado],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: #,0
		lineageTag: fc5208c7-1694-48fc-9075-b790f30f1ec8

	/// Contratos que superan en mas de 10 veces el p99 de su propia modalidad de contratacion. Se compara contra la modalidad y no contra el universo porque la modalidad refleja un rango de cuantia definido por ley. Decision D3.
	measure 'Contratos atipicos' =
			CALCULATE (
			    COUNTROWS ( hecho_contratos ),
			    hecho_contratos[veces_p99_modalidad] > 10
			)
		formatString: #,0
		lineageTag: 5b93fe62-7e61-4bbf-8477-5b697f842b3a

	/// Nula en 2.619 contratos: 2.583 sin fecha de inicio y 36 donde la resta saldria negativa.
	measure 'Duracion promedio dias' =
			AVERAGE ( hecho_contratos[duracion_dias] )
		formatString: #,0
		lineageTag: e8d53e5e-91bc-459c-b3fa-07a508491ff4

