# Copiar a .env (que esta en .gitignore) y poner valores propios:
#
#   cp orquestacion/.env.ejemplo orquestacion/.env
#
# Docker Compose lee .env de esta carpeta automaticamente. Si no existe, el
# compose usa los valores por defecto y Airflow levanta igual: estas variables
# son para no dejar secretos por defecto en un repo publico.

# Firma los tokens con los que las tareas hablan con la Execution API.
# Tiene que ser el mismo en todos los servicios, y no quedarse en el default.
#   openssl rand -base64 24
AIRFLOW__API_AUTH__JWT_SECRET=cambiame

# Cifra las credenciales guardadas en la base de metadatos. Aqui no se guarda
# ninguna (DuckDB es un archivo local), asi que puede quedar vacia en local.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Usuario de la interfaz web.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Solo hace falta en Linux, para que los archivos que escriben los contenedores
# en dags/, logs/ y data/ no queden con dueno root. En Windows y macOS se
# ignora. En Linux:   echo "AIRFLOW_UID=$(id -u)"
# AIRFLOW_UID=50000

# --- Avisos de fallo ---
# Cuando una tarea agota sus reintentos, el DAG manda un correo con asunto
# "SECOP pipeline FALLO - <tarea>". Un flujo de Power Automate lo recoge y
# notifica al movil.
#
# Con Gmail NO sirve la contrasena de la cuenta: hay que crear una
# "contrasena de aplicacion" (requiere verificacion en dos pasos).
# Si se dejan vacias, no se manda nada y el pipeline corre igual.
ALERTA_SMTP_HOST=smtp.gmail.com
ALERTA_SMTP_PUERTO=587
ALERTA_SMTP_USUARIO=
ALERTA_SMTP_CLAVE=
# El buzon que vigila el flujo de Power Automate.
ALERTA_DESTINO=

